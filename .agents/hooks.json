{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run -p familiar-cli --quiet -- hook --source antigravity --event SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run -p familiar-cli --quiet -- hook --source antigravity --event PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run -p familiar-cli --quiet -- hook --source antigravity --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run -p familiar-cli --quiet -- hook --source antigravity --event SessionEnd",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
