{
  "name": "pixel-cat",
  "author": "community",
  "version": "1.0.0",
  "sprite_sheet": "sprites.jpg",
  "grid": [2, 2],
  "animations": {
    "idle":         { "frames": [0], "fps": 2, "loop": true },
    "thinking":     { "frames": [0], "fps": 1, "loop": true },
    "working":      { "frames": [2], "fps": 4, "loop": true },
    "happy":        { "frames": [0], "fps": 4, "loop": true },
    "alarmed":      { "frames": [3], "fps": 8, "loop": true },
    "sleeping":     { "frames": [1], "fps": 1, "loop": true },
    "celebrating":  { "frames": [0], "fps": 6, "loop": false },
    "watching":     { "frames": [0], "fps": 2, "loop": true }
  },
  "bubbles": {
    "reading":   "📖 Reading {file}",
    "writing":   "✍️ Writing {file}",
    "command":   "⚡ Running {cmd}",
    "workflow":  "⚙️ {workflow}",
    "pipeline":  "🚀 {pipeline}",
    "error":     "❌ Error!"
  }
}
