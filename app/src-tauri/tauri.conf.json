{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Familiar",
        "width": 320,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "active": true
  },
  "identifier": "com.samgl.familiar"
}
