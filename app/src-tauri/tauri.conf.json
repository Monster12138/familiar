{
  "build": {
    "beforeBuildCommand": "cargo build --release -p familiar-cli && mkdir -p src-tauri/bin && cp ../target/release/familiar-cli src-tauri/bin/ && npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Familiar",
        "width": 320,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": [
      "bin/familiar-cli"
    ]
  },
  "identifier": "com.samgl.familiar"
}
