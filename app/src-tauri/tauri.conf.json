{
  "build": {
    "beforeBuildCommand": "cargo build --release -p familiar-cli && npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Familiar",
        "width": 320,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../target/release/familiar-cli": "bin/familiar-cli",
      "../../ASSETS.md": "ASSETS.md",
      "../../LICENSE-APACHE": "LICENSE-APACHE",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../sprites": "sprites"
    }
  },
  "identifier": "com.samgl.familiar",
  "productName": "Familiar"
}
