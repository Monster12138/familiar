{
  "build": {
    "beforeBuildCommand": "cargo build --release -p familiar-cli && npm run build",
    "beforeDevCommand": "cargo build --release -p familiar-cli && npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.config/familiar/sprites/**/*",
          "$APPDATA/familiar/sprites/**/*"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Familiar",
        "width": 320,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../ASSETS.md": "ASSETS.md",
      "../../LICENSE-APACHE": "LICENSE-APACHE",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../config/default.toml": "config/default.toml",
      "../../sprites": "sprites"
    }
  },
  "identifier": "com.samgl.familiar",
  "productName": "Familiar"
}
